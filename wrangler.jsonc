{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hellboxcomics",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",

  // Gate 3.1 public state.
  // "sealed" means ordinary visitors see the Sealed Press surface while a
  // valid __Host-hellbox_prelaunch cookie continues to receive the real site.
  "vars": {
    "HELLBOX_PRELAUNCH_MODE": "sealed"
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",

    // Gate 3.1 requires the Worker to make the public/private document decision
    // before Cloudflare's static asset cache. Ordinary assets still fall through
    // to env.ASSETS.fetch(request) in src/index.js.
    "run_worker_first": true
  },

  // Hellbox project storage uses only hellbox-public and hellbox-private.
  // The legacy hellbox-assets bucket is intentionally excluded forever.
  "r2_buckets": [
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "hellbox-public"
    },
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "hellbox-private"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hellbox-production",
      "database_id": "cc09b526-b9bb-4b23-a5b1-d02deaf7dbd6",
      "migrations_dir": "migrations"
    }
  ]
}
